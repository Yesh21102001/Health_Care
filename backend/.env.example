# Copy to .env and fill in real values. .env is git-ignored: NEVER commit secrets.

# development | production
ENVIRONMENT=development

# MongoDB Atlas: Database > Connect > Drivers
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=healthai

# Browser origins allowed to call this API (comma-separated).
# The user app and the admin app.
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# true only when this API sits behind a proxy you control (Next.js rewrites, Vercel, etc.)
# that sets X-Forwarded-For. If the API is reachable directly, set false.
TRUST_PROXY=true

# Anthropic API key: https://console.anthropic.com/ > API Keys. Server-side only.
# Leave empty to run without AI (chat returns "AI not configured").
ANTHROPIC_API_KEY=
# Optional overrides
# CLAUDE_MODEL=claude-sonnet-5-5
# CHAT_EFFORT=low
# REPORT_EFFORT=medium
